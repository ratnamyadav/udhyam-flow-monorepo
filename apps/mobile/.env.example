# Optional: apps/mobile also loads the monorepo root .env / .env.local (see
# load-root-env.js), so you normally only set EXPO_PUBLIC_AUTH_URL there.
# Values here (copy to apps/mobile/.env) or in the shell take precedence.
#
# Base URL of the web app (BetterAuth + tRPC API). On a physical device this
# must be reachable from the phone, e.g. your machine's LAN IP. When unset in
# development the app uses the Metro host (Constants.expoConfig.hostUri) on
# port 3000; release builds fall back to https://udyamflow.com.
EXPO_PUBLIC_AUTH_URL="http://192.168.1.20:3000"
