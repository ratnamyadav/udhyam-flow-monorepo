{
  "extends": "@udyamflow/tsconfig/expo.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    },
    "jsx": "react-jsx",
    "types": ["expo/types"]
  },
  "include": [
    "app/**/*",
    "components/**/*",
    "lib/**/*",
    "*.ts",
    "*.tsx",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
