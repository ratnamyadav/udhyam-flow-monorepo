{
  "expo": {
    "name": "UdyamFlow",
    "slug": "udyamflow",
    "scheme": "udyamflow",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbfaf8"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.udyamflow.app",
      "associatedDomains": [
        "applinks:udyamflow.com"
      ]
    },
    "android": {
      "package": "com.udyamflow.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1815"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "udyamflow.com",
              "pathPrefix": "/book/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "./plugins/with-large-screen-support"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "owner": "nextfly_technologies",
    "extra": {
      "eas": {
        "projectId": "d0d78bd0-2017-4e31-b6fc-1d66fb8c53a5"
      }
    }
  }
}
