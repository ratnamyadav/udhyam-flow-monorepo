{
  "expo": {
    "name": "UdyamFlow",
    "slug": "udyamflow",
    "scheme": "udyamflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbfaf8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.udyamflow.app",
      "associatedDomains": ["applinks:udyamflow.com"]
    },
    "android": {
      "package": "com.udyamflow.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1815"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "udyamflow.com",
              "pathPrefix": "/book/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
