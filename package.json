{
  "name": "udyamflow",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check-types": "turbo check-types",
    "clean": "turbo clean && rm -rf node_modules",
    "db:push": "pnpm --filter @udyamflow/db db:push",
    "db:generate": "pnpm --filter @udyamflow/db db:generate",
    "db:migrate": "pnpm --filter @udyamflow/db db:migrate",
    "db:constraints": "pnpm --filter @udyamflow/db db:constraints",
    "db:seed": "pnpm --filter @udyamflow/db db:seed",
    "db:backfill-customers": "pnpm --filter @udyamflow/db db:backfill-customers",
    "test": "turbo test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "pnpm": {
    "overrides": {
      "@expo/metro-config>lightningcss": "1.30.1",
      "@better-auth/core>@better-auth/utils": "0.4.2",
      "@better-auth/utils": "0.4.2",
      "@xmldom/xmldom@^0.8.0": "0.8.15",
      "@xmldom/xmldom@^0.9.0": "0.9.12",
      "baseline-browser-mapping@^2.0.0": "2.11.27",
      "brace-expansion@^5.0.0": "5.0.12",
      "browserslist@^4.0.0": "4.29.3",
      "fast-uri@^3.0.0": "3.1.8",
      "js-yaml@^4.0.0": "4.3.2",
      "shell-quote@^1.0.0": "1.12.0",
      "ws@^7.0.0": "7.5.13",
      "ws@^8.0.0": "8.22.0",
      "metro-file-map@0.84.3": "0.84.5",
      "metro-babel-transformer@0.84.3": "0.84.5",
      "metro-resolver@0.84.3": "0.84.5",
      "metro-source-map@0.84.3": "0.84.5",
      "metro-cache-key@0.84.3": "0.84.5",
      "metro-symbolicate@0.84.3": "0.84.5",
      "metro-runtime@0.84.3": "0.84.5",
      "metro-cache@0.84.3": "0.84.5",
      "metro-transform-worker@0.84.3": "0.84.5",
      "metro-config@0.84.3": "0.84.5",
      "metro@0.84.3": "0.84.5",
      "metro-core@0.84.3": "0.84.5",
      "metro-minify-terser@0.84.3": "0.84.5",
      "metro-transform-plugins@0.84.3": "0.84.5"
    },
    "patchedDependencies": {
      "decode-uri-component@0.2.2": "patches/decode-uri-component@0.2.2.patch"
    }
  }
}
