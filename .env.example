# ─── Required ──────────────────────────────────────────────────────────────

# Neon Postgres connection (used by packages/db and BetterAuth via packages/auth)
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# BetterAuth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-me-with-32-bytes-of-random"
BETTER_AUTH_URL="http://localhost:3000"

# Web app (apps/web)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_AUTH_URL="http://localhost:3000"

# ─── Optional ──────────────────────────────────────────────────────────────
# Every block below can stay empty in dev; the feature degrades gracefully.

# Admin app public URL (apps/admin) — trusted by BetterAuth for sign-in.
ADMIN_APP_URL="http://localhost:3001"
# Extra comma-separated origins BetterAuth should accept.
TRUSTED_ORIGINS=""

# Mobile app (apps/mobile) — points at the web app's auth + API. On a physical
# device use your machine's LAN IP, e.g. http://192.168.1.20:3000.
EXPO_PUBLIC_AUTH_URL="http://localhost:3000"

# Encryption key for tenant secrets at rest (≥32 chars; openssl rand -hex 32).
# Falls back to a key derived from BETTER_AUTH_SECRET. To rotate, move the old
# value to ENCRYPTION_KEY_PREVIOUS.
ENCRYPTION_KEY=""
ENCRYPTION_KEY_PREVIOUS=""

# Email (Resend). When set, new accounts must verify their email.
RESEND_API_KEY=""
EMAIL_FROM="UdyamFlow <noreply@udyamflow.com>"

# Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payments — Stripe (non-INR prices). Two webhook endpoints, both pointing at
# /api/payments/stripe/webhook: one for platform events, one for Connect
# ("events on connected accounts"). Each has its own signing secret.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""

# Payments — Cashfree (INR prices). Platform account; tenants register a
# payout account (Easy Split vendor) in Settings → Payments and INR payments
# are split to them.
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""
CASHFREE_ENV="sandbox" # sandbox | production
# % of each INR order the platform keeps (default 0), and whether to refuse
# INR checkouts for tenants without an ACTIVE payout vendor.
# CASHFREE_PLATFORM_FEE_PERCENT="0"
# CASHFREE_REQUIRE_VENDOR="false"

# Invoicing — FreshBooks OAuth app (optional). Redirect URI to register:
#   ${NEXT_PUBLIC_APP_URL}/api/integrations/freshbooks/callback  (must be https)
FRESHBOOKS_CLIENT_ID=""
FRESHBOOKS_CLIENT_SECRET=""

# Invoicing — Zoho Books OAuth client (optional). Redirect URI to register:
#   ${NEXT_PUBLIC_APP_URL}/api/integrations/zoho/callback
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
# ZOHO_ACCOUNTS_URL="https://accounts.zoho.in"

# SMS + WhatsApp (MSG91, India). DLT-approved template ids.
MSG91_AUTH_KEY=""
MSG91_SMS_SENDER=""
MSG91_SMS_TEMPLATE_ID=""
MSG91_SMS_CANCEL_TEMPLATE_ID=""
MSG91_WHATSAPP_INTEGRATED_NUMBER=""
# MSG91 inbound WhatsApp webhook secret (customer Confirm/Cancel replies) —
# configure the MSG91 inbound webhook as
#   POST {APP_URL}/api/notifications/whatsapp/inbound?secret=$MSG91_WEBHOOK_SECRET
MSG91_WEBHOOK_SECRET=""

# WhatsApp/SMS reminders — .github/workflows/reminders.yml calls
# /api/cron/reminders hourly with "Authorization: Bearer $CRON_SECRET" (add the
# same value, plus REMINDERS_APP_URL, as GitHub Actions secrets).
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Tenant logo uploads — any S3-compatible object storage.
#   AWS S3:      set BUCKET, REGION, keys; leave ENDPOINT empty (public URL is derived)
#   R2:          ENDPOINT=https://<account>.r2.cloudflarestorage.com, REGION=auto
#   MinIO:       ENDPOINT=http://localhost:9000, FORCE_PATH_STYLE=true
#   Spaces/B2/Wasabi: their S3 endpoint + region
# STORAGE_PUBLIC_URL is where objects are publicly readable (CDN, r2.dev, or
# bucket URL). The bucket needs a CORS rule allowing PUT from your app origin.
# (The older R2_ACCOUNT_ID/R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY/R2_BUCKET/
# R2_PUBLIC_URL variables still work.)
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""
STORAGE_FORCE_PATH_STYLE="false"

# Rate limiting shared across instances (Upstash Redis). Without it each
# server instance keeps its own in-memory counters.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# The client-IP header your host sets and clients can't spoof
# (cf-connecting-ip behind Cloudflare, x-real-ip on Vercel).
TRUSTED_IP_HEADER=""

# Error monitoring (Sentry)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
