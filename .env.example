# ─── Required ──────────────────────────────────────────────────────────────

# Neon Postgres connection (used by packages/db and BetterAuth via packages/auth)
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# BetterAuth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-me-with-32-bytes-of-random"
BETTER_AUTH_URL="http://localhost:3000"

# Web app (apps/web)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_AUTH_URL="http://localhost:3000"

# ─── Optional ──────────────────────────────────────────────────────────────
# Every block below can stay empty in dev; the feature degrades gracefully.

# Admin app public URL (apps/admin) — trusted by BetterAuth for sign-in.
ADMIN_APP_URL="http://localhost:3001"
# Extra comma-separated origins BetterAuth should accept.
TRUSTED_ORIGINS=""

# Mobile app (apps/mobile) — points at the web app's auth + API. On a physical
# device use your machine's LAN IP, e.g. http://192.168.1.20:3000.
EXPO_PUBLIC_AUTH_URL="http://localhost:3000"

# Encryption key for tenant secrets at rest (≥32 chars; openssl rand -hex 32).
# Falls back to a key derived from BETTER_AUTH_SECRET. To rotate, move the old
# value to ENCRYPTION_KEY_PREVIOUS.
ENCRYPTION_KEY=""
ENCRYPTION_KEY_PREVIOUS=""

# Email (Resend). When set, new accounts must verify their email.
RESEND_API_KEY=""
EMAIL_FROM="UdyamFlow <noreply@udyamflow.com>"

# Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payments — Stripe (non-INR prices). Two webhook endpoints, both pointing at
# /api/payments/stripe/webhook: one for platform events, one for Connect
# ("events on connected accounts"). Each has its own signing secret.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""

# Payments — Cashfree (INR prices). Platform account; tenants can also add
# their own credentials in Settings → Payments.
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""
CASHFREE_ENV="sandbox" # sandbox | production

# SMS + WhatsApp (MSG91, India). DLT-approved template ids.
MSG91_AUTH_KEY=""
MSG91_SMS_SENDER=""
MSG91_SMS_TEMPLATE_ID=""
MSG91_SMS_CANCEL_TEMPLATE_ID=""
MSG91_WHATSAPP_INTEGRATED_NUMBER=""

# Tenant logo uploads (Cloudflare R2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Rate limiting shared across instances (Upstash Redis). Without it each
# server instance keeps its own in-memory counters.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# The client-IP header your host sets and clients can't spoof
# (cf-connecting-ip behind Cloudflare, x-real-ip on Vercel).
TRUSTED_IP_HEADER=""

# Error monitoring (Sentry)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
