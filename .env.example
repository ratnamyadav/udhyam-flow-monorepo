# Neon Postgres connection (used by packages/db and BetterAuth via packages/auth)
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# BetterAuth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-me-with-32-bytes-of-random"
BETTER_AUTH_URL="http://localhost:3000"

# Web app (apps/web)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_AUTH_URL="http://localhost:3000"

# Admin app (apps/admin)
ADMIN_AUTH_URL="http://localhost:3001"

# Mobile app (apps/mobile) — points at the web app's auth handler in dev
EXPO_PUBLIC_AUTH_URL="http://localhost:3000"

# Invoicing — FreshBooks OAuth app (optional). Redirect URI to register:
#   ${NEXT_PUBLIC_APP_URL}/api/integrations/freshbooks/callback  (must be https)
FRESHBOOKS_CLIENT_ID=""
FRESHBOOKS_CLIENT_SECRET=""

# Invoicing — Zoho Books OAuth client (optional). Redirect URI to register:
#   ${NEXT_PUBLIC_APP_URL}/api/integrations/zoho/callback
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
# ZOHO_ACCOUNTS_URL="https://accounts.zoho.in"

# Cashfree Easy Split (tenant payouts) — optional tuning.
# CASHFREE_PLATFORM_FEE_PERCENT="0"
# CASHFREE_REQUIRE_VENDOR="false"

# WhatsApp reminders (optional) — hourly Vercel Cron hits /api/cron/reminders
# with "Authorization: Bearer $CRON_SECRET". Generate with: openssl rand -hex 32
CRON_SECRET=""
# MSG91 inbound WhatsApp webhook secret — configure the MSG91 inbound webhook as
# POST {APP_URL}/api/notifications/whatsapp/inbound?secret=$MSG91_WEBHOOK_SECRET
MSG91_WEBHOOK_SECRET=""
